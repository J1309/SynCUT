{
  "buildCommand": "npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon\\.ico|metadata\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
